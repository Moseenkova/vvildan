# Copy this file to .env and provide real values. Never commit .env.
# Compose database settings. DATABASE_URL is assembled by compose.yaml.
POSTGRES_DB=courier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
APP_PORT=8080

# Used when running the Python services outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/courier
BOT_TOKEN=replace-with-telegram-bot-token
SUPPORT_GROUP_ID=-1001234567890
SUPPORT_GROUP_ADMIN_IDS=123456789,987654321

# Replace these in any non-development deployment.
SECRET_KEY=replace-with-a-long-random-secret
URL_TOKEN_SALT=replace-with-a-long-random-salt
MODE=PROD
