#: src/i18n.js:63
msgid "User Not Found"
msgstr "ಬಳಕೆದಾರ ಕಂಡುಬಂದಿಲ್ಲ"

#: src/i18n.js:64
msgid "You are not registered in the system. Please register through the Telegram bot first."
msgstr "ನೀವು ವ್ಯವಸ್ಥೆಯಲ್ಲಿ ನೋಂದಾಯಿಸಲಾಗಿಲ್ಲ. ದಯವಿಟ್ಟು ಮೊದಲು ಟೆಲಿಗ್ರಾಮ್ ಬಾಟ್ ಮೂಲಕ ನೋಂದಾಯಿಸಿ."
