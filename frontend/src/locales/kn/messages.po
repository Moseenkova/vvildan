msgid "For example: Clothes 5 kg, documents, electronics"
msgstr "ಉದಾಹರಣೆಗೆ: ಬಟ್ಟೆ 5 ಕೆಜಿ, ದಾಖಲೆಗಳು, ಎಲೆಕ್ಟ್ರಾನಿಕ್ಸ್"

#: src/i18n.js:62
msgid "Form submitted! Check the console for data."
msgstr "ಫಾರ್ಮ್ ಸಲ್ಲಿಸಲಾಗಿದೆ! ಡೇಟಾಕ್ಕಾಗಿ ಕನ್ಸೋಲ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ."

#: src/i18n.js:37
msgid "From date"
msgstr "ದಿನಾಂಕದಿಂದ"

#: src/i18n.js:54
msgid "Loading..."
msgstr "ಲೋಡ್ ಆಗುತ್ತಿದೆ..."

#: src/i18n.js:41
msgid "mm/dd/yyyy"
msgstr "dd/mm/yyyy"

#: src/i18n.js:40
msgid "MM/dd/yyyy"
msgstr "dd/MM/yyyy"

#: src/i18n.js:61
msgid "Please select a date"
msgstr "ದಯವಿಟ್ಟು ದಿನಾಂಕವನ್ನು ಆಯ್ಕೆಮಾಡಿ"

