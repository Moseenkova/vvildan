#: src/i18n.js:64
msgid "Please select a start date"
msgstr "ದಯವಿಟ್ಟು ಪ್ರಾರಂಭ ದಿನಾಂಕವನ್ನು ಆಯ್ಕೆಮಾಡಿ"

#: src/i18n.js:65
msgid "Please select an end date"
msgstr "ದಯವಿಟ್ಟು ಅಂತಿಮ ದಿನಾಂಕವನ್ನು ಆಯ್ಕೆಮಾಡಿ"

#: src/i18n.js:46
msgid "Please select departure and arrival airports from the list"
msgstr "ದಯವಿಟ್ಟು ಪಟ್ಟಿಯಿಂದ ನಿರ್ಗಮನ ಮತ್ತು ಆಗಮನದ ವಿಮಾನ ನಿಲ್ದಾಣಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ"

#: src/i18n.js:47
msgid "Remove"
msgstr "ತೆಗೆದುಹಾಕಿ"

#: src/i18n.js:44
msgid "country, city or airport"
msgstr "ದೇಶ, ನಗರ ಅಥವಾ ವಿಮಾನ ನಿಲ್ದಾಣ"

#: src/i18n.js:35
msgid "Sender"
msgstr "ಕಳುಹಿಸುವವರು"

#: src/i18n.js:63
msgid "Submit request"
msgstr "ವಿನಂತಿಯನ್ನು ಸಲ್ಲಿಸಿ"

#: src/i18n.js:66
msgid "The start date cannot be after the end date"
msgstr "ಪ್ರಾರಂಭ ದಿನಾಂಕವು ಅಂತಿಮ ದಿನಾಂಕದ ನಂತರ ಇರುವಂತಿಲ್ಲ"

#: src/i18n.js:38
msgid "To date"
msgstr "ಇಲ್ಲಿಯವರೆಗೆ"

#: src/i18n.js:69
msgid "User Not Found"
msgstr "ಬಳಕೆದಾರ ಕಂಡುಬಂದಿಲ್ಲ"

#: src/i18n.js:70
msgid "You are not registered in the system. Please register through the Telegram bot first."
msgstr "ನೀವು ವ್ಯವಸ್ಥೆಯಲ್ಲಿ ನೋಂದಾಯಿಸಲಾಗಿಲ್ಲ. ದಯವಿಟ್ಟು ಮೊದಲು ಟೆಲಿಗ್ರಾಮ್ ಬಾಟ್ ಮೂಲಕ ನೋಂದಾಯಿಸಿ."
