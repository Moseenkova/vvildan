msgid "Choose a country first"
msgstr "ಮೊದಲು ದೇಶವನ್ನು ಆರಿಸಿ"

#: src/i18n.js:36
msgid "Courier"
msgstr "ಕೊರಿಯರ್"

#: src/i18n.js:39
msgid "Date"
msgstr "ದಿನಾಂಕ"

#: src/i18n.js:46
msgid "Departure airport"
msgstr "ನಿರ್ಗಮನ ವಿಮಾನ ನಿಲ್ದಾಣ"

#: src/i18n.js:43
msgid "Departure city"
msgstr "ನಿರ್ಗಮನ ನಗರ"

#: src/i18n.js:42
