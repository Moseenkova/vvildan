msgid "mm/dd/yyyy"
msgstr "dd/mm/yyyy"

#: src/i18n.js:40
msgid "MM/dd/yyyy"
msgstr "dd/MM/yyyy"

#: src/i18n.js:45
msgid "no matching airports found, try to write in english"
msgstr "ಹೊಂದಿಕೆಯಾಗುವ ಯಾವುದೇ ವಿಮಾನ ನಿಲ್ದಾಣ ಕಂಡುಬಂದಿಲ್ಲ, ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಬರೆಯಲು ಪ್ರಯತ್ನಿಸಿ"

#: src/i18n.js:67
msgid "Please select a date"
