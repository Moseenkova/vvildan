#: src/i18n.js:43
msgid "Arrival"
msgstr "வருகை"

#: src/i18n.js:53
msgid "Arrival airport"
msgstr "வருகை விமான நிலையம்"

#: src/i18n.js:51
msgid "Arrival city"
msgstr "வருகை நகரம்"

#: src/i18n.js:50
msgid "Arrival country"
msgstr "வருகை நாடு"

#: src/i18n.js:61
msgid "Baggage comments"
msgstr "பேக்கேஜ் கருத்துகள்"

#: src/i18n.js:59
msgid "Choose a city first"
msgstr "முதலில் ஒரு நகரத்தைத் தேர்ந்தெடுங்கள்"

#: src/i18n.js:55
msgid "Choose a country first"
msgstr "முதலில் ஒரு நாட்டை தேர்ந்தெடுங்கள்"

#: src/i18n.js:36
msgid "Courier"
msgstr "கூரியர்"

#: src/i18n.js:39
msgid "Date"
msgstr "தேதி"

#: src/i18n.js:42
msgid "Departure"
msgstr "புறப்பாடு"

#: src/i18n.js:52
msgid "Departure airport"
msgstr "புறப்படும் விமான நிலையம்"

#: src/i18n.js:49
msgid "Departure city"
msgstr "புறப்படும் நகரம்"

#: src/i18n.js:48
msgid "Departure country"
msgstr "புறப்படும் நாடு"

#: src/i18n.js:57
msgid "Enter a city"
msgstr "ஒரு நகரத்தை உள்ளிடவும்"

#: src/i18n.js:54
msgid "Enter a country"
msgstr "ஒரு நாட்டை உள்ளிடவும்"

#: src/i18n.js:56
msgid "Enter or choose a city"
msgstr "நகரத்தை உள்ளிடவும் அல்லது தேர்வு செய்யவும்"

#: src/i18n.js:58
msgid "Enter or choose an airport"
msgstr "விமான நிலையத்தை உள்ளிடவும் அல்லது தேர்வு செய்யவும்"

#: src/i18n.js:62
msgid "For example: Clothes 5 kg, documents, electronics"
msgstr "உதாரணமாக: ஆடைகள் 5 கிலோ, ஆவணங்கள், மின்னணுவியல்"

#: src/i18n.js:68
msgid "Form submitted! Check the console for data."
msgstr "படிவம் சமர்ப்பிக்கப்பட்டது! டேட்டாவிற்கு கன்சோலைச் சரிபார்க்கவும்."

#: src/i18n.js:37
msgid "From date"
msgstr "தேதியிலிருந்து"

#: src/i18n.js:60
msgid "Loading..."
msgstr "ஏற்றுகிறது..."

#: src/i18n.js:47
#~ msgid "Maximum number of airports selected"
#~ msgstr ""

#: src/i18n.js:41
msgid "mm/dd/yyyy"
msgstr "dd/mm/yyyy"

#: src/i18n.js:40
msgid "MM/dd/yyyy"
msgstr "dd/MM/yyyy"

#: src/i18n.js:45
msgid "no matching airports found, try to write in english"
msgstr "பொருந்தும் விமான நிலையங்கள் எதுவும் கிடைக்கவில்லை, ஆங்கிலத்தில் எழுத முயற்சிக்கவும்"

#: src/i18n.js:67
msgid "Please select a date"
msgstr "தேதியைத் தேர்ந்தெடுக்கவும்"

#: src/i18n.js:64
msgid "Please select a start date"
msgstr "தொடக்கத் தேதியைத் தேர்ந்தெடுக்கவும்"

#: src/i18n.js:65
msgid "Please select an end date"
msgstr "இறுதித் தேதியைத் தேர்ந்தெடுக்கவும்"

#: src/i18n.js:46
msgid "Please select departure and arrival airports from the list"
msgstr "பட்டியலிலிருந்து புறப்படும் மற்றும் வந்தடையும் விமான நிலையங்களைத் தேர்ந்தெடுக்கவும்"

#: src/i18n.js:47
msgid "Remove"
msgstr "அகற்று"

#: src/i18n.js:44
msgid "country, city or airport"
msgstr "நாடு, நகரம் அல்லது விமான நிலையம்"

#: src/i18n.js:35
msgid "Sender"
msgstr "அனுப்புபவர்"

#: src/i18n.js:63
msgid "Submit request"
msgstr "கோரிக்கையை சமர்ப்பிக்கவும்"

#: src/i18n.js:66
msgid "The start date cannot be after the end date"
msgstr "தொடக்கத் தேதி முடிவுத் தேதிக்குப் பிறகு இருக்க முடியாது"

#: src/i18n.js:38
msgid "To date"
msgstr "இன்றுவரை"

#: src/i18n.js:69
msgid "User Not Found"
msgstr "பயனர் கிடைக்கவில்லை"

#: src/i18n.js:70
msgid "You are not registered in the system. Please register through the Telegram bot first."
msgstr "நீங்கள் கணினியில் பதிவு செய்யப்படவில்லை. முதலில் Telegram bot மூலம் பதிவு செய்யவும்."
